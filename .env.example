# Copia este archivo a .env y completa tus propios valores.
# .env NUNCA debe subirse al repositorio (ya está en .gitignore).

# Django
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-generada-para-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MongoDB Atlas
# Cadena de conexión del cluster (Atlas > Connect > Drivers), con usuario y
# contraseña de un usuario de base de datos (no tu cuenta de Atlas).
MONGO_URI=mongodb+srv://<usuario>:<contrasena>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=canigo

# Cloudinary (almacenamiento de imagenes: fotos de perfil, mascotas, paseos,
# incidentes). Dashboard de Cloudinary > Product Environment Credentials.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Panel de administracion (RF14 - verificacion de paseadores): correos de las
# cuentas que pueden entrar a /administracion/verificacion/, separados por
# coma. No crea un rol nuevo - deben ser correos de cuentas ya registradas.
CANIGO_ADMIN_EMAILS=admin@canigo.test
